// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Enums are not supported in SQLite, using Strings with documentation
// UserRole: STUDENT, TEACHER, PARENT, ADMIN
// Cycle: INTERDISCIPLINAR, AUTORAL, ENSINO_MEDIO
// MissionType: QUIZ, SIMULATION, INTERACTIVE, TASK

model School {
  id        String   @id @default(uuid())
  name      String
  location  String?
  users     User[]
  classes   Class[]
  createdAt DateTime @default(now())
}

model Class {
  id        String            @id @default(uuid())
  name      String
  schoolId  String
  school    School            @relation(fields: [schoolId], references: [id])
  teacherId String
  teacher   User              @relation("TeacherClasses", fields: [teacherId], references: [id])
  students  User[]            @relation("StudentClasses")
  locks     ClassModuleLock[]
  createdAt DateTime          @default(now())
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     String @default("STUDENT")

  // Tracking
  currentGrade Int @default(4) // 4 to 12 (12 = 3rd Grade HS)
  xp           Int @default(0)
  coins        Int @default(0)

  // Relations
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  managedClasses Class[] @relation("TeacherClasses")
  studentClasses Class[] @relation("StudentClasses")

  progress             StudentProgress[]
  gradeHistory         GradeHistory[]
  badges               UserBadge[]
  challengeCompletions DailyChallengeCompletion[]
  inventory            UserItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GradeHistory {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  grade         Int // Year the student was in
  totalXPGained Int
  completedAt   DateTime @default(now())
}

model Volume {
  id      Int      @id // 1 to 9
  title   String
  cycle   String
  modules Module[]
}

model Module {
  id        String            @id @default(uuid())
  volumeId  Int
  volume    Volume            @relation(fields: [volumeId], references: [id])
  bimonthly Int // 1, 2, 3 or 4
  title     String
  missions  Mission[]
  locks     ClassModuleLock[]
}

model Mission {
  id          String  @id @default(uuid())
  moduleId    String
  module      Module  @relation(fields: [moduleId], references: [id])
  type        String
  order       Int     @default(1) // 1 to 8
  title       String
  description String?
  xpReward    Int
  coinsReward Int
  contentData String // Stores questions, simulation parameters, etc. (JSON String)

  progress StudentProgress[]
}

model StudentProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  missionId   String
  mission     Mission  @relation(fields: [missionId], references: [id])
  score       Float?
  completed   Boolean  @default(false)
  completedAt DateTime @default(now())

  @@unique([userId, missionId])
}

model Badge {
  id          String      @id @default(uuid())
  name        String
  description String
  iconUrl     String
  requirement String // Logic to unlock (e.g., { "missionCount": 10 }) (JSON String)
  users       UserBadge[]
}

model UserBadge {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  awardedAt DateTime @default(now())

  @@id([userId, badgeId])
}

model DailyChallenge {
  id          String                     @id @default(uuid())
  title       String
  description String?
  type        String // QUIZ, INFO, ACTION
  content     String? // JSON data
  rewardXp    Int                        @default(10)
  rewardCoins Int                        @default(5)
  date        DateTime                   @unique @default(now())
  completions DailyChallengeCompletion[]
}

model DailyChallengeCompletion {
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  challengeId String
  challenge   DailyChallenge @relation(fields: [challengeId], references: [id])
  completedAt DateTime       @default(now())

  @@id([userId, challengeId])
}

model Item {
  id          String     @id @default(uuid())
  name        String
  description String?
  price       Int
  category    String // AVATAR_HAT, AVATAR_SHIRT, AVATAR_BIKE, etc.
  imageUrl    String
  users       UserItem[]
}

model UserItem {
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  isEquipped Boolean  @default(false)
  acquiredAt DateTime @default(now())

  @@id([userId, itemId])
}

model ClassModuleLock {
  classId    String
  class      Class     @relation(fields: [classId], references: [id])
  moduleId   String
  module     Module    @relation(fields: [moduleId], references: [id])
  isUnlocked Boolean   @default(false)
  unlockedAt DateTime?

  @@id([classId, moduleId])
}
